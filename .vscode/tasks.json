{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "ui",
      "type": "shell",
      "isBackground": true,
      "command": "just ui",
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "ingest:mock",
      "type": "shell",
      "command": "uv run graphrev ingest --adapter mock --seed 1337",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "problemMatcher": []
    },
    {
      "label": "test",
      "type": "shell",
      "command": "just test",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "migrate",
      "type": "shell",
      "command": "just migrate",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    }
  ]
}
