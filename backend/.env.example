# Copy to .env and adjust. Every value here has a sane default in
# backend/src/graphrev/core/config.py — this file only needs entries you
# actually want to override.

# -- F1: adapters, DB, concurrency --
GRAPHREV_DB_PATH=./graphrev.db
GRAPHREV_GHIDRA_ADAPTER=mock
GRAPHREV_LLM_ADAPTER=mock
GRAPHREV_LLM_MODEL=mock-llm-v1
GRAPHREV_SUMMARY_CONCURRENCY=4
GRAPHREV_QUEUE_MAX_DEPTH=500
GRAPHREV_HOST=127.0.0.1
GRAPHREV_PORT=8000
GRAPHREV_LOG_LEVEL=INFO
GRAPHREV_LOG_JSON=false

# -- F1a: the five PRD-named UI tuning constants --
GRAPHREV_TABLE_ROW_CAP=64
GRAPHREV_CALLER_SUPPRESS_THRESHOLD=32
GRAPHREV_UTILITY_FANIN_THRESHOLD=50
GRAPHREV_FAN_OUT_ALL_HARD_CAP=50
GRAPHREV_NODE_COUNT_SOFT_WARNING=150

# -- TAD additions (docs/adr/0003-invented-constants.md) --
GRAPHREV_CARD_WIDTH_PX=440
GRAPHREV_NAME_ANALYST_MAX_LENGTH=128
GRAPHREV_NODE_PATCH_DEBOUNCE_MS=250
GRAPHREV_VIEW_PATCH_DEBOUNCE_MS=400
GRAPHREV_NOTES_AUTOSAVE_DEBOUNCE_MS=600
GRAPHREV_SUMMARY_DEMAND_DEBOUNCE_MS=250
GRAPHREV_SSE_KEEPALIVE_SECONDS=15
GRAPHREV_SSE_SUBSCRIBER_QUEUE_SIZE=256
GRAPHREV_SQLITE_BUSY_TIMEOUT_MS=5000

# -- MockLlmAdapter tuning (off by default; see README "Configuration") --
GRAPHREV_MOCK_LLM_SIMULATE_LATENCY=false
GRAPHREV_MOCK_LLM_MIN_LATENCY_SECONDS=1.0
GRAPHREV_MOCK_LLM_MAX_LATENCY_SECONDS=8.0
GRAPHREV_MOCK_LLM_FAILURE_RATE=0.05

# -- I13 real adapters --
# litellm (option A): llm_model is a litellm router string, e.g.
# "anthropic/claude-sonnet-4-5", "openai/gpt-4o", "ollama/llama3".
#GRAPHREV_LLM_API_BASE=
#GRAPHREV_LLM_API_KEY=
#GRAPHREV_SUMMARY_REQUEST_TIMEOUT_SECONDS=120

# opencode (option B): `opencode serve` is the sidecar — run it from
# tools/opencode-ghidra/ (see its README). Agent runs are minutes-long, so
# they get their own (wider) timeout.
#GRAPHREV_OPENCODE_URL=http://127.0.0.1:4096
#GRAPHREV_OPENCODE_AGENT=graphrev-re
#GRAPHREV_OPENCODE_PASSWORD=
#GRAPHREV_AGENT_MAX_TOOL_CALLS=40
#GRAPHREV_AGENT_TIMEOUT_SECONDS=300
